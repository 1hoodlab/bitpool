# Server
HOST=127.0.0.1
PORT=8080

# Database (PostgreSQL). Used when running migrations or connecting from app.
# Match these with docker-compose if you use it (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB).
DATABASE_URL=postgres://bitpool:bitpool@localhost:5432/bitpool

# Docker Compose (optional): override Postgres env for docker-compose.yml
# POSTGRES_USER=bitpool
# POSTGRES_PASSWORD=bitpool
# POSTGRES_DB=bitpool
# POSTGRES_PORT=5432

# Log level: error, warn, info, debug, trace
RUST_LOG=info
